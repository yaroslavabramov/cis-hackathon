# Devin API (v3): personal access token or service user key, plus your org id
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_REPO=yaroslavabramov/cis-hackathon
# Start Devin automatically when a session is diverted (1) or only from the console button (0)
DEVIN_AUTO=1
# Daytona: when set, the shadow bank boots inside a Daytona sandbox
DAYTONA_API_KEY=
# MIRAGE_SHADOW=local   # force the local shadow process even if DAYTONA_API_KEY is set
# DEMO_START=01:59:20   # demo clock start time

# PR from an earlier Devin run, shown in the console while the live session is still working
DEVIN_REFERENCE_PR=
